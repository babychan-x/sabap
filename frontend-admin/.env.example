# 管理者用フロントエンドの設定の見本（学生用と同じ）。
# 使うときは、このファイルをコピーして「.env.local」という名前にして、値を書き換える。
# （.env.local は .gitignore で除外されているので、GitHub には上がらない）
# ※ VITE_ で始まる値は、ブラウザに送られる（誰でも見られる）。パスワードなどの秘密は、絶対に書かない。
# ※ 書き換えたら、npm run dev を一度止めて、もう一度起動する。

# true（書かないときも true）: サーバーに繋がず、ダミーのデータを使う
# false: 本物のバックエンドに繋ぐ（バックエンドを 8080 番で動かしておく）
VITE_USE_MOCK=true

# API の URL の先頭。開発中は空のまま（vite.config.js の proxy が 8080 番に転送する）
VITE_API_BASE_URL=
